<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- network.server is required under the sandbox for the Dart VM service
	     (hot reload / DevTools / flutter attach) to accept inbound connections
	     in debug — do NOT remove it. network.client (outbound) was removed
	     (CSO F4): a local-only vault makes zero outbound calls, so keeping it
	     only widened the supply-chain exfil surface. Release is already clean. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Backup export/restore: the user picks the .kbx location via the native
	     panel. Minimal grant — no broad file or downloads access. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
