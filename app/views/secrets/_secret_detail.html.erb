<div class="p-6">
  <div class="flex items-start justify-between mb-6">
    <div>
      <h1 class="text-xl font-bold text-[var(--text-primary)]"><%= @secret.name %></h1>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-200">
          <%= @secret.secret_type.humanize %>
        </span>
        <% if @secret.service_name.present? %>
          <span class="text-sm text-[var(--text-secondary)]"><%= @secret.service_name %></span>
        <% end %>
        <% if @secret.environment.present? %>
          <%= environment_badge(@secret.environment) %>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-1">
      <%= link_to edit_secret_path(@secret), class: "p-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] rounded-md hover:bg-brand-50 dark:hover:bg-[var(--surface-card)] transition-colors", aria: { label: "Edit secret" } do %>
        <%= lucide_icon(:pencil, size: 4) %>
      <% end %>
      <%= button_to secret_path(@secret), method: :delete,
        class: "p-1.5 text-[var(--text-secondary)] hover:text-red-600 rounded-md hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors",
        aria: { label: "Delete secret" },
        data: { turbo_confirm: "Are you sure you want to delete this secret?" } do %>
        <%= lucide_icon(:trash_2, size: 4) %>
      <% end %>
    </div>
  </div>

  <%# Secret Value %>
  <div class="mb-6" data-controller="reveal clipboard" data-clipboard-secret-id-value="<%= @secret.id %>">
    <label class="block text-sm font-medium text-[var(--text-secondary)] mb-2">Secret Value</label>
    <div class="relative">
      <pre class="w-full px-3 py-2.5 bg-[var(--surface-secondary)] dark:bg-[var(--surface-card)] border border-[var(--border-primary)] rounded-md font-mono text-sm break-all whitespace-pre-wrap"
           data-reveal-target="content"><%= @decrypted_value&.chars&.map { "•" }&.join %></pre>
      <pre class="w-full px-3 py-2.5 bg-[var(--surface-secondary)] dark:bg-[var(--surface-card)] border border-[var(--border-primary)] rounded-md font-mono text-sm break-all whitespace-pre-wrap hidden"
           data-reveal-target="revealed"><%= @decrypted_value %></pre>
      <div class="absolute top-2 right-2 flex items-center gap-1">
        <button type="button"
                data-action="reveal#toggle"
                class="p-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] rounded transition-colors"
                aria-label="Toggle secret visibility">
          <%= lucide_icon(:eye, size: 4, data: { reveal_target: "eyeOpen" }) %>
          <%= lucide_icon(:eye_off, size: 4, css_class: "hidden", data: { reveal_target: "eyeClosed" }) %>
        </button>
        <button type="button"
                data-action="clipboard#copy"
                data-clipboard-target="button"
                class="p-1 text-[var(--text-secondary)] hover:text-brand-600 rounded transition-colors"
                aria-label="Copy to clipboard">
          <%= lucide_icon(:clipboard_copy, size: 4, data: { clipboard_target: "icon" }) %>
        </button>
      </div>
    </div>
  </div>

  <%# Metadata %>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
    <div>
      <dt class="text-[var(--text-secondary)]">Folder</dt>
      <dd class="mt-1 text-[var(--text-primary)]"><%= @secret.folder.name %></dd>
    </div>
    <% if @secret.tags.present? %>
      <div>
        <dt class="text-[var(--text-secondary)]">Tags</dt>
        <dd class="mt-1 flex flex-wrap gap-1">
          <% @secret.tags_array.each do |tag| %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-200"><%= tag %></span>
          <% end %>
        </dd>
      </div>
    <% end %>
    <% if @secret.notes.present? %>
      <div class="sm:col-span-2">
        <dt class="text-[var(--text-secondary)]">Notes</dt>
        <dd class="mt-1 text-[var(--text-primary)]"><%= @secret.notes %></dd>
      </div>
    <% end %>
    <div>
      <dt class="text-[var(--text-secondary)]">Created</dt>
      <dd class="mt-1 text-[var(--text-primary)]"><%= @secret.created_at.strftime("%b %d, %Y %H:%M") %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-secondary)]">Last accessed</dt>
      <dd class="mt-1 text-[var(--text-primary)]">
        <%= @secret.last_accessed_at ? @secret.last_accessed_at.strftime("%b %d, %Y %H:%M") : "Never" %>
      </dd>
    </div>
    <div>
      <dt class="text-[var(--text-secondary)]">Access count</dt>
      <dd class="mt-1 text-[var(--text-primary)]"><%= @secret.access_count %></dd>
    </div>
  </dl>
</div>
