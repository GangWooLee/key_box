<div class="bg-[var(--surface-primary)] rounded-lg shadow-card border border-[var(--border-primary)] p-4 hover:shadow-card-hover transition-shadow">
  <div class="flex items-start justify-between">
    <div class="flex-1 min-w-0">
      <%= link_to secret, class: "block group" do %>
        <h3 class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-brand-600 transition-colors truncate">
          <%= secret.name %>
        </h3>
      <% end %>
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-200">
          <%= secret.secret_type.humanize %>
        </span>
        <% if secret.service_name.present? %>
          <span class="text-xs text-[var(--text-secondary)]"><%= secret.service_name %></span>
        <% end %>
        <% if secret.environment.present? %>
          <%= environment_badge(secret.environment) %>
        <% end %>
      </div>
      <% if secret.folder %>
        <p class="mt-1 text-xs text-[var(--text-secondary)]"><%= secret.folder.name %></p>
      <% end %>
    </div>

    <div class="flex items-center gap-1 ml-3" data-controller="clipboard" data-clipboard-secret-id-value="<%= secret.id %>">
      <button type="button"
              data-action="clipboard#copy"
              data-clipboard-target="button"
              class="p-1.5 text-[var(--text-secondary)] hover:text-brand-600 rounded-md hover:bg-brand-50 dark:hover:bg-[var(--surface-card)] transition-colors"
              aria-label="Copy secret value">
        <%= lucide_icon(:clipboard_copy, size: 4, data: { clipboard_target: "icon" }) %>
      </button>
    </div>
  </div>
</div>
