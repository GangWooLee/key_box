<% content_for(:title, "#{@secret.name} — KeyBox") %>

<turbo-frame id="secret_detail">
  <% if !turbo_frame_request? %>
    <%# Standalone mode (mobile / direct navigation) %>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-6">
        <%= link_to secrets_path, class: "inline-flex items-center gap-1 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors" do %>
          <%= lucide_icon(:arrow_left, size: 4) %>
          Back to Secrets
        <% end %>
      </div>

      <div class="bg-[var(--surface-primary)] rounded-lg shadow-card border border-[var(--border-primary)]">
        <%= render "secrets/secret_detail" %>
      </div>
    </div>
  <% else %>
    <%# Frame mode (desktop detail pane) %>
    <%= render "secrets/secret_detail" %>
  <% end %>
</turbo-frame>
