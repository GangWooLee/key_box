<div class="h-14 px-4 flex items-center hover:bg-brand-50 dark:hover:bg-[var(--surface-card)] transition-colors cursor-pointer group"
     data-secret-id="<%= secret.id %>"
     id="secret_item_<%= secret.id %>">
  <%= link_to secret_path(secret),
        class: "flex-1 block overflow-hidden",
        data: { split_view_target: "link", action: "split-view#select", secret_id: secret.id.to_s, turbo_frame: "_top" } do %>
    <div class="flex flex-col justify-center h-full">
      <div class="flex items-center justify-between">
        <h3 class="text-[14px] font-semibold text-[var(--text-primary)] truncate leading-tight"><%= secret.name %></h3>
        <% if secret.environment.present? %>
          <div class="shrink-0 ml-2">
            <%= environment_dot(secret.environment) %>
          </div>
        <% end %>
      </div>
      <div class="mt-0.5 flex items-center gap-1.5 text-[12px] font-normal text-[var(--text-secondary)]">
        <% if secret.service_name.present? %>
          <span class="truncate"><%= secret.service_name %></span>
          <span class="text-[var(--text-tertiary)]">&bull;</span>
        <% end %>
        <span><%= secret.secret_type.humanize %></span>
        <span class="text-[var(--text-tertiary)] ml-auto hidden group-hover:inline-block">
          <%= time_ago_in_words(secret.updated_at) %> ago
        </span>
      </div>
    </div>
  <% end %>
</div>
