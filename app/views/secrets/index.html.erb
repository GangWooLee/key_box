<% content_for(:title, "Secrets — KeyBox") %>

<div class="h-[calc(100dvh-3.5rem)] flex" data-controller="split-view" data-split-view-active-class="bg-brand-50 dark:bg-brand-950">
  <%# Column 1: Sidebar — Folders %>
  <aside class="hidden md:flex flex-col w-sidebar flex-shrink-0 bg-[var(--surface-sidebar)] backdrop-blur-xl border-r border-[var(--border-subtle)] overflow-y-auto">
    <div class="p-3">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">Folders</h2>
        <%= link_to new_vault_folder_path(@vault), class: "text-brand-600 hover:text-brand-700 transition-colors", aria: { label: "New folder" } do %>
          <%= lucide_icon(:plus, size: 4) %>
        <% end %>
      </div>
      <nav class="space-y-0.5" aria-label="Folders">
        <% @folders.each do |folder| %>
          <div class="flex items-center justify-between px-2 py-1.5 rounded-md text-sm
                      text-[var(--text-primary)] hover:bg-brand-50 dark:hover:bg-[var(--surface-card)] transition-colors group">
            <span class="flex items-center gap-2">
              <%= lucide_icon(:folder, size: 4, css_class: "text-[var(--text-secondary)]") %>
              <span class="truncate"><%= folder.name %></span>
            </span>
            <span class="text-[10px] text-[var(--text-secondary)]"><%= folder.secrets_count %></span>
          </div>
        <% end %>
      </nav>
    </div>

    <div class="mt-auto p-3 border-t border-[var(--border-subtle)] space-y-1">
      <%= link_to search_path, class: "flex items-center gap-2 px-2 py-1.5 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-brand-50 dark:hover:bg-[var(--surface-card)] rounded-md transition-colors" do %>
        <%= lucide_icon(:search, size: 4) %>
        <span>Search</span>
      <% end %>
    </div>
  </aside>

  <%# Column 2: Secret List %>
  <div class="w-full lg:w-72 flex-shrink-0 border-r border-[var(--border-subtle)] flex flex-col overflow-hidden" data-split-view-target="list">
    <div class="flex items-center justify-between px-3 py-2 border-b border-[var(--border-subtle)]">
      <div>
        <h1 class="text-sm font-semibold text-[var(--text-primary)]">Secrets</h1>
        <p class="text-[10px] text-[var(--text-secondary)]"><%= pluralize(@secrets.size, "secret") %></p>
      </div>
      <%= link_to new_secret_path, class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md transition-colors" do %>
        <%= lucide_icon(:plus, size: 3) %>
        New
      <% end %>
    </div>

    <div class="flex-1 overflow-y-auto divide-y divide-[var(--border-subtle)]" id="secret_list">
      <% if @secrets.any? %>
        <% @secrets.each do |secret| %>
          <%= render "secrets/secret_list_item", secret: secret %>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center h-full text-center p-6">
          <%= lucide_icon(:lock, size: 10, css_class: "text-[var(--text-tertiary)]") %>
          <h3 class="mt-3 text-sm font-medium text-[var(--text-primary)]">No secrets yet</h3>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">Get started by adding your first secret.</p>
          <div class="mt-3">
            <%= link_to new_secret_path, class: "inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md transition-colors" do %>
              <%= lucide_icon(:plus, size: 3) %>
              Add Secret
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Column 3: Detail Pane (desktop only) %>
  <div class="hidden lg:flex flex-1 flex-col overflow-y-auto" data-split-view-target="detail">
    <turbo-frame id="secret_detail" class="flex-1 flex flex-col">
      <%= render "secrets/detail_empty" %>
    </turbo-frame>
  </div>
</div>
