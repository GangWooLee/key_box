<%= form_with(model: secret, class: "space-y-5") do |form| %>
  <% if secret.errors.any? %>
    <div class="rounded-lg bg-red-50 dark:bg-red-900/20 p-4 border border-red-200 dark:border-red-800" role="alert">
      <div class="flex">
        <%= lucide_icon(:alert_triangle, size: 5, css_class: "text-red-400 flex-shrink-0") %>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-300">
            <%= pluralize(secret.errors.count, "error") %> prevented this secret from being saved:
          </h3>
          <ul class="mt-2 text-sm text-red-700 dark:text-red-400 list-disc pl-5 space-y-1">
            <% secret.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Name", class: "block text-sm font-medium text-[var(--text-primary)]" %>
    <%= form.text_field :name,
      class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
              bg-[var(--surface-primary)] text-[var(--text-primary)]
              focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors",
      placeholder: "e.g., GitHub API Key",
      required: true %>
  </div>

  <div data-controller="reveal">
    <%= form.label :value, "Secret Value", class: "block text-sm font-medium text-[var(--text-primary)]" %>
    <div class="mt-1 relative">
      <%= form.text_area :value,
        rows: 3,
        class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm font-mono
                bg-[var(--surface-primary)] text-[var(--text-primary)]
                focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors",
        placeholder: "Paste your secret value here",
        required: secret.new_record?,
        data: { reveal_target: "input" } %>
      <button type="button"
              data-action="reveal#toggle"
              class="absolute top-2 right-2 p-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
              aria-label="Toggle secret visibility">
        <%= lucide_icon(:eye, size: 4, data: { reveal_target: "eyeOpen" }) %>
        <%= lucide_icon(:eye_off, size: 4, css_class: "hidden", data: { reveal_target: "eyeClosed" }) %>
      </button>
    </div>
    <% unless secret.new_record? %>
      <p class="mt-1 text-xs text-[var(--text-secondary)]">Leave blank to keep the current value.</p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :folder_id, "Folder", class: "block text-sm font-medium text-[var(--text-primary)]" %>
      <%= form.select :folder_id,
        @folders.map { |f| [f.name, f.id] },
        {},
        class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                bg-[var(--surface-primary)] text-[var(--text-primary)]
                focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :secret_type, "Type", class: "block text-sm font-medium text-[var(--text-primary)]" %>
      <%= form.select :secret_type,
        Secret::SECRET_TYPES.map { |t| [t.humanize, t] },
        {},
        class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                bg-[var(--surface-primary)] text-[var(--text-primary)]
                focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :service_name, "Service", class: "block text-sm font-medium text-[var(--text-primary)]" %>
      <%= form.text_field :service_name,
        class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                bg-[var(--surface-primary)] text-[var(--text-primary)]
                focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors",
        placeholder: "e.g., GitHub, AWS" %>
    </div>

    <div>
      <%= form.label :environment, "Environment", class: "block text-sm font-medium text-[var(--text-primary)]" %>
      <%= form.select :environment,
        [["None", ""]] + Secret::ENVIRONMENTS.map { |e| [e.capitalize, e] },
        {},
        class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                bg-[var(--surface-primary)] text-[var(--text-primary)]
                focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Notes", class: "block text-sm font-medium text-[var(--text-primary)]" %>
    <%= form.text_area :notes,
      rows: 2,
      class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
              bg-[var(--surface-primary)] text-[var(--text-primary)]
              focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors",
      placeholder: "Optional notes about this secret" %>
  </div>

  <div>
    <%= form.label :tags, "Tags", class: "block text-sm font-medium text-[var(--text-primary)]" %>
    <%= form.text_field :tags,
      class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
              bg-[var(--surface-primary)] text-[var(--text-primary)]
              focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors",
      placeholder: "Comma-separated: api, production, critical" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancel", secrets_path, class: "px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors" %>
    <%= form.submit secret.new_record? ? "Create Secret" : "Update Secret",
      class: "px-4 py-1.5 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
  </div>
<% end %>
