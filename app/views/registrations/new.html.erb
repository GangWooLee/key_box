<% content_for(:title, "Sign up — KeyBox") %>

<div class="min-h-[calc(100dvh-4rem)] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm space-y-8">
    <div class="text-center">
      <%= lucide_icon(:key_round, size: 10, css_class: "mx-auto text-brand-600") %>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-[var(--text-primary)]">Create your account</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Already have an account?
        <%= link_to "Log in", login_path, class: "font-medium text-brand-600 hover:text-brand-500" %>
      </p>
    </div>

    <%= form_with model: @user, url: signup_path, method: :post, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded-lg bg-red-50 dark:bg-red-900/20 p-4 border border-red-200 dark:border-red-800" role="alert">
          <h2 class="text-sm font-medium text-red-800 dark:text-red-300">
            Please fix the following errors:
          </h2>
          <ul class="mt-2 list-disc list-inside text-sm text-red-700 dark:text-red-400 space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-[var(--text-primary)]" %>
        <div class="mt-1">
          <%= f.text_field :name,
            required: true, autofocus: true, autocomplete: "name",
            class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                    bg-[var(--surface-primary)] text-[var(--text-primary)]
                    focus:ring-2 focus:ring-brand-500 focus:border-brand-500
                    placeholder:text-[var(--text-secondary)] transition-colors",
            placeholder: "Your name" %>
        </div>
      </div>

      <div>
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-[var(--text-primary)]" %>
        <div class="mt-1">
          <%= f.email_field :email,
            required: true, autocomplete: "email",
            class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                    bg-[var(--surface-primary)] text-[var(--text-primary)]
                    focus:ring-2 focus:ring-brand-500 focus:border-brand-500
                    placeholder:text-[var(--text-secondary)] transition-colors",
            placeholder: "you@example.com" %>
        </div>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-sm font-medium text-[var(--text-primary)]" %>
        <div class="mt-1">
          <%= f.password_field :password,
            required: true, autocomplete: "new-password",
            class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                    bg-[var(--surface-primary)] text-[var(--text-primary)]
                    focus:ring-2 focus:ring-brand-500 focus:border-brand-500
                    placeholder:text-[var(--text-secondary)] transition-colors",
            placeholder: "Minimum 8 characters" %>
        </div>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-[var(--text-primary)]" %>
        <div class="mt-1">
          <%= f.password_field :password_confirmation,
            required: true, autocomplete: "new-password",
            class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                    bg-[var(--surface-primary)] text-[var(--text-primary)]
                    focus:ring-2 focus:ring-brand-500 focus:border-brand-500
                    placeholder:text-[var(--text-secondary)] transition-colors",
            placeholder: "Enter password again" %>
        </div>
      </div>

      <%= f.submit "Create account",
        class: "w-full flex justify-center py-1.5 px-3 rounded-md text-sm font-semibold
               text-white bg-brand-600 hover:bg-brand-700
               focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2
               transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    <% end %>
  </div>
</div>
