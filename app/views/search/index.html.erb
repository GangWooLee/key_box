<% content_for(:title, "Search — KeyBox") %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-[var(--text-primary)] mb-6">Search Secrets</h1>

  <div data-controller="search">
    <%= form_with(url: search_path, method: :get, class: "mb-6", data: { search_target: "form", action: "input->search#submit" }) do %>
      <div class="relative">
        <%= lucide_icon(:search, size: 5, css_class: "absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-secondary)]") %>
        <input type="search" name="q" value="<%= params[:q] %>"
          class="w-full pl-10 pr-4 py-2 border border-[var(--border-primary)] rounded-md text-sm
                 bg-[var(--surface-primary)] text-[var(--text-primary)]
                 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
          placeholder="Search by name, service, tags, or notes..."
          autofocus
          data-search-target="input">
      </div>
    <% end %>

    <div id="search_results">
      <% if params[:q].present? %>
        <p class="text-sm text-[var(--text-secondary)] mb-4">
          <%= pluralize(@secrets.size, "result") %> for "<%= params[:q] %>"
        </p>

        <% if @secrets.any? %>
          <div class="space-y-3">
            <% @secrets.each do |secret| %>
              <%= render "secrets/secret_card", secret: secret %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12">
            <%= lucide_icon(:search, size: 12, css_class: "mx-auto text-[var(--text-tertiary)]") %>
            <h3 class="mt-4 text-lg font-semibold text-[var(--text-primary)]">No results found</h3>
            <p class="mt-2 text-sm text-[var(--text-secondary)]">Try a different search term.</p>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-12">
          <%= lucide_icon(:search, size: 12, css_class: "mx-auto text-[var(--text-tertiary)]") %>
          <h3 class="mt-4 text-lg font-semibold text-[var(--text-primary)]">Search your secrets</h3>
          <p class="mt-2 text-sm text-[var(--text-secondary)]">Search by name, service, tags, or notes.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
