<%= turbo_stream.update "search_results" do %>
  <% if params[:q].present? %>
    <p class="text-sm text-gray-500 mb-4">
      <%= pluralize(@secrets.size, "result") %> for "<%= params[:q] %>"
    </p>

    <% if @secrets.any? %>
      <div class="space-y-3">
        <% @secrets.each do |secret| %>
          <%= render "secrets/secret_card", secret: secret %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto size-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <h3 class="mt-4 text-lg font-semibold text-gray-900">No results found</h3>
        <p class="mt-2 text-sm text-gray-500">Try a different search term.</p>
      </div>
    <% end %>
  <% end %>
<% end %>
