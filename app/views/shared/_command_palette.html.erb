<%# Command Palette (Cmd+K / Ctrl+K) %>
<div data-controller="command-palette">
  <div data-command-palette-target="overlay"
       data-action="click->command-palette#closeBackground"
       class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-start justify-center pt-[20vh]">
    <div class="w-full max-w-lg mx-4 bg-[var(--surface-primary)]/80 backdrop-blur-xl rounded-xl shadow-2xl border border-[var(--border-primary)] overflow-hidden">
      <%# Search input %>
      <div class="flex items-center gap-3 px-4 py-3 border-b border-[var(--border-subtle)]">
        <%= lucide_icon(:search, size: 5, css_class: "text-[var(--text-secondary)] flex-shrink-0") %>
        <input type="text"
               data-command-palette-target="input"
               data-action="input->command-palette#search"
               class="flex-1 bg-transparent text-sm text-[var(--text-primary)] placeholder:text-[var(--text-secondary)] outline-none"
               placeholder="Search secrets..."
               autocomplete="off">
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium text-[var(--text-secondary)] bg-brand-50 dark:bg-[var(--surface-card)] rounded">ESC</kbd>
      </div>

      <%# Results %>
      <div data-command-palette-target="results" class="max-h-72 overflow-y-auto py-1">
        <% if logged_in? && current_user.personal_vault %>
          <% current_user.personal_vault.secrets.includes(:folder).recent.limit(50).each do |secret| %>
            <div data-command-palette-target="item"
                 data-name="<%= secret.name %>"
                 data-service="<%= secret.service_name %>"
                 data-tags="<%= secret.tags %>"
                 class="px-4 py-2 cursor-pointer transition-colors">
              <%= link_to secret_path(secret),
                    data: { action: "command-palette#selectResult" },
                    class: "flex items-center justify-between" do %>
                <div class="flex items-center gap-3 min-w-0">
                  <% if secret.service_name.present? %>
                    <%= service_icon(secret.service_name) %>
                  <% else %>
                    <%= lucide_icon(:key_round, size: 5, css_class: "text-[var(--text-secondary)]") %>
                  <% end %>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-[var(--text-primary)] truncate"><%= secret.name %></p>
                    <p class="text-xs text-[var(--text-secondary)] truncate">
                      <%= secret.folder.name %>
                      <% if secret.service_name.present? %>
                        &middot; <%= secret.service_name %>
                      <% end %>
                    </p>
                  </div>
                </div>
                <% if secret.environment.present? %>
                  <%= environment_dot(secret.environment) %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <%# Footer %>
      <div class="px-4 py-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[10px] text-[var(--text-secondary)]">
        <div class="flex items-center gap-3">
          <span><kbd class="font-medium">&uarr;&darr;</kbd> navigate</span>
          <span><kbd class="font-medium">&crarr;</kbd> open</span>
          <span><kbd class="font-medium">esc</kbd> close</span>
        </div>
        <span>KeyBox</span>
      </div>
    </div>
  </div>
</div>
