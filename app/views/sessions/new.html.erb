<% content_for(:title, "Log in — KeyBox") %>

<div class="min-h-[calc(100dvh-4rem)] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm space-y-8">
    <div class="text-center">
      <%= lucide_icon(:key_round, size: 10, css_class: "mx-auto text-brand-600") %>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-[var(--text-primary)]">Log in to KeyBox</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Don't have an account?
        <%= link_to "Sign up", signup_path, class: "font-medium text-brand-600 hover:text-brand-500" %>
      </p>
    </div>

    <%= form_with url: login_path, method: :post, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-[var(--text-primary)]", for: "email" %>
        <div class="mt-1">
          <%= f.email_field :email, id: "email",
            required: true, autofocus: true, autocomplete: "email",
            class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                    bg-[var(--surface-primary)] text-[var(--text-primary)]
                    focus:ring-2 focus:ring-brand-500 focus:border-brand-500
                    placeholder:text-[var(--text-secondary)] transition-colors",
            placeholder: "you@example.com" %>
        </div>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-sm font-medium text-[var(--text-primary)]", for: "password" %>
        <div class="mt-1">
          <%= f.password_field :password, id: "password",
            required: true, autocomplete: "current-password",
            class: "w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
                    bg-[var(--surface-primary)] text-[var(--text-primary)]
                    focus:ring-2 focus:ring-brand-500 focus:border-brand-500
                    placeholder:text-[var(--text-secondary)] transition-colors",
            placeholder: "Enter your password" %>
        </div>
      </div>

      <div class="flex items-center">
        <%= f.check_box :remember_me, { id: "remember_me", class: "size-4 rounded border-[var(--border-primary)] text-brand-600 focus:ring-brand-500" }, "1", "0" %>
        <%= f.label :remember_me, "Remember me for 30 days", class: "ml-2 text-sm text-[var(--text-secondary)]", for: "remember_me" %>
      </div>

      <%= f.submit "Log in",
        class: "w-full flex justify-center py-1.5 px-3 rounded-md text-sm font-semibold
               text-white bg-brand-600 hover:bg-brand-700
               focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2
               transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    <% end %>
  </div>
</div>
