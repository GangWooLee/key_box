<%= form_with(model: [@vault, folder], class: "space-y-5") do |form| %>
  <% if folder.errors.any? %>
    <div class="rounded-lg bg-red-50 dark:bg-red-900/20 p-4 border border-red-200 dark:border-red-800" role="alert">
      <ul class="text-sm text-red-700 dark:text-red-400 list-disc pl-5 space-y-1">
        <% folder.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Folder Name", class: "block text-sm font-medium text-[var(--text-primary)]" %>
    <%= form.text_field :name,
      class: "mt-1 w-full px-3 py-1.5 border border-[var(--border-primary)] rounded-md text-sm
              bg-[var(--surface-primary)] text-[var(--text-primary)]
              focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors",
      placeholder: "e.g., Production Keys",
      required: true %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancel", root_path, class: "px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors" %>
    <%= form.submit folder.new_record? ? "Create Folder" : "Update Folder",
      class: "px-4 py-1.5 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
  </div>
<% end %>
